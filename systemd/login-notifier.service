[Unit]
Description=Telegram notifications for server logins
After=network-online.target systemd-journald.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=PYTHONPATH=/opt/login-notifier PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m login_notifier --config /etc/login-notifier/config.json
Restart=on-failure
RestartSec=5
# Exit status 2 = invalid config; restarting won't help until it is fixed.
RestartPreventExitStatus=2
StateDirectory=login-notifier
SyslogIdentifier=login-notifier

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
